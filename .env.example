NODE_ENV=
PORT=
JWT_SECRET=
DB_HOST=
DB_USER=
DB_PASS=
DATABASE=
DB_PORT=
FRONTEND_URL=

# ── SMS (Collections → SMS). Default "log" only records messages as SIMULATED. ──
SMS_PROVIDER=log
# BulkSMSBD:   SMS_PROVIDER=bulksmsbd   + SMS_API_KEY, SMS_SENDER_ID
# SSL Wireless: SMS_PROVIDER=sslwireless + SMS_API_TOKEN, SMS_SID
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_TOKEN=
SMS_SID=

# ── Online payment via SSLCommerz (bKash / Nagad / Rocket / cards) ──
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWD=
SSLCZ_SANDBOX=true
# Public base URL of this API — SSLCommerz posts success/IPN callbacks here
PUBLIC_API_URL=http://localhost:5050
# Local testing without a merchant account (ignored when NODE_ENV=production)
PAYMENT_MOCK=false

# Scheduled jobs (Operations → Automation). Times use this server's local clock — run it with TZ=Asia/Dhaka.
# Set to false on every API instance except one if you run several.
SCHEDULER_ENABLED=true
